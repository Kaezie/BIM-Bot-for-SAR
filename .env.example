# Copy this file to .env and fill in the real values from your Supabase project
# (Settings → API in the Supabase dashboard). Never commit the real .env file.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=recordings

# Optional feature endpoints. Empty means unavailable; no readings are invented.
CAMERA_URL=http://192.168.4.1:81/stream
SENSOR_URL=http://192.168.4.1/dht
NIGHTVISION_CAMERA_URL=
# SAR thermal video stream (future hardware, as in the original repository).
THERMAL_URL=http://192.168.4.1:82/stream
# Optional dashboard temperature-grid JSON; separate from the video stream.
THERMAL_DATA_URL=
SOUND_URL=
POSITION_URL=
ROBOT_URL=
ROBOT_COMMAND_URL=
ROBOT_COMMAND_KEY=

# Trusted local weights only; no automatic model downloads.
YOLO_MODEL_PATH=best.pt
# SAR generate_frames keeps its original person class 14 and confidence 0.25.
POSE_MODEL_PATH=yolo11s-pose.pt

# Use 5050 if macOS AirPlay Receiver occupies port 5000.
PORT=5000
