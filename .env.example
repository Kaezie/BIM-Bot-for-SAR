# Copy this file to .env and fill in the real values from your Supabase project
# (Settings → API in the Supabase dashboard). Never commit the real .env file.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=recordings

# Laptop sessions, MP4 files, and the persistent cloud-upload queue.
# Default: <this project>/local_data. Keep this folder when restarting/updating.
# LOCAL_DATA_DIR=/absolute/path/to/bimbot-local-data

# Optional feature endpoints. Empty means unavailable; no readings are invented.
CAMERA_URL=http://192.168.4.1:81/stream
SENSOR_URL=http://192.168.4.1/dht
NIGHTVISION_CAMERA_URL=
# Set to false for viewing/recording without experimental night-camera detection.
NIGHTVISION_DETECTION_ENABLED=true
# SAR thermal video stream (future hardware, as in the original repository).
THERMAL_URL=http://192.168.4.1:82/stream
# Optional dashboard temperature-grid JSON; separate from the video stream.
THERMAL_DATA_URL=
SOUND_URL=
# Optional robot-position JSON bridge; never the operator laptop's location.
# WGS84 needs explicit valid-fix + sample-age/sequence metadata; see docs/POSITION_INTEGRATION.md.
POSITION_URL=
# Recorded Uno commands/durations, not GPS. Start scripts/uno_movement_bridge.py explicitly.
# After setup: MOVEMENT_URL=http://127.0.0.1:5054/movement
MOVEMENT_URL=
# Optional command endpoint http://127.0.0.1:5054/command; matching ROBOT_COMMAND_KEY required.
# Supervised return requires both the firmware option and bridge flag; see docs/UNO_MOVEMENT_SETUP.md.
MOVEMENT_COMMAND_URL=
ROBOT_URL=
ROBOT_COMMAND_URL=
ROBOT_COMMAND_KEY=

# Trusted local weights only; no automatic model downloads.
YOLO_MODEL_PATH=best.pt
# SAR generate_frames keeps its original person class 14 and confidence 0.25.
POSE_MODEL_PATH=yolo11s-pose.pt

# Use 5050 if macOS AirPlay Receiver occupies port 5000.
PORT=5000
